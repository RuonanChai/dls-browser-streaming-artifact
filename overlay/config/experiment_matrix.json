{
  "name": "ready_single_user",
  "paper_title": "READY: Readiness-Aware Delivery for Interactive 3D Gaussian Splatting",
  "scenario": "single_user_cold_start",
  "warmup_ms": 0,
  "move_ms": 40000,
  "timeout_ms": 1200000,
  "prefetch_budget_bytes": 134217728,
  "parse_budget_chunks_per_sec": 24,
  "default_prediction_horizon_ms": 2000,
  "ready_event_policy": "parse_or_upload",
  "default_trace": "orbit",
  "traces": {
    "orbit": {
      "id": "orbit",
      "replay": "orbit"
    },
    "stop_go": {
      "id": "stop_go",
      "replay": "stop_go"
    },
    "burst_turn": {
      "id": "burst_turn",
      "replay": "burst_turn"
    },
    "random_walk": {
      "id": "random_walk",
      "replay": "random_walk"
    }
  },
  "network_profiles": {
    "WAN-M": {
      "rtt_ms": 40,
      "bandwidth_mbps": 100
    },
    "WAN-S": {
      "rtt_ms": 80,
      "bandwidth_mbps": 50
    },
    "WAN-H": {
      "rtt_ms": 150,
      "bandwidth_mbps": 20
    },
    "LAN-like": {
      "rtt_ms": 20,
      "bandwidth_mbps": 500
    },
    "No-Throttle": {
      "rtt_ms": 0,
      "bandwidth_mbps": 0,
      "note": "No CDP throttle - use real COS latency (~145ms)"
    }
  },
  "deliveries": {
    "edge_server": {
      "profile_id": "edge_server",
      "delivery_role": "edge",
      "display_name": "LAN edge server (same LAN as laptop)",
