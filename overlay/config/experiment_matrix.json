    },
    "origin_server": {
      "profile_id": "edge_server",
      "delivery_role": "edge",
      "display_name": "alias of edge_server",
      "asset_url": "http://${EDGE_SERVER_HOST}:8090/examples/streaming-lod/coit-40m-sh1-lod.rad"
    },
    "local_disk": {
      "profile_id": "local_disk",
      "delivery_role": "local",
      "display_name": "local ceiling / loopback",
      "note": "browser-side control; excludes network variables"
    },
    "remote_server": {
      "profile_id": "remote_server",
